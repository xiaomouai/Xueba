```dart
// lib/modules/pronunciation/audio_recorder.dart

import 'dart:async';
import 'dart:io';
import 'dart:typed_data';
import 'package:record/record.dart';
import 'package:path_provider/path_provider.dart';

class AudioRecorder {
  final Record _recorder = Record();
  String? _currentPath;
  Timer? _amplitudeTimer;
  final StreamController<double> _amplitudeController = StreamController<double>.broadcast();
  
  Stream<double> get amplitudeStream => _amplitudeController.stream;
  
  /// 开始录音
  Future<void> startRecording() async {
    // 检查权限
    if (!await _recorder.hasPermission()) {
      throw Exception('没有录音权限');
    }
    
    // 生成临时文件路径
    final directory = await getTemporaryDirectory();
    _currentPath = '${directory.path}/recording_${DateTime.now().millisecondsSinceEpoch}.wav';
    
    // 配置录音参数
    await _recorder.start(
      path: _currentPath,
      encoder: AudioEncoder.wav,       // WAV格式
      bitRate: 256000,                  // 比特率
      samplingRate: 16000,              // 16kHz采样率
      numChannels: 1,                   // 单声道
    );
    
    // 开始监听音量
    _startAmplitudeMonitor();
  }
  
  /// 停止录音
  Future<Uint8List?> stopRecording() async {
    _stopAmplitudeMonitor();
    
    final path = await _recorder.stop();
    if (path == null) return null;
    
    // 读取音频文件
    final file = File(path);
    final audioData = await file.readAsBytes();
    
    // 删除临时文件
    await file.delete();
    
    return audioData;
  }
  
  /// 取消录音
  Future<void> cancelRecording() async {
    _stopAmplitudeMonitor();
    await _recorder.stop();
    
    if (_currentPath != null) {
      final file = File(_currentPath!);
      if (await file.exists()) {
        await file.delete();
      }
    }
  }
  
  /// 监听音量变化（用于波形动画）
  void _startAmplitudeMonitor() {
    _amplitudeTimer = Timer.periodic(
      const Duration(milliseconds: 50),
      (_) async {
        final amplitude = await _recorder.getAmplitude();
        _amplitudeController.add(amplitude.current);
      },
    );
  }
  
  void _stopAmplitudeMonitor() {
    _amplitudeTimer?.cancel();
    _amplitudeTimer = null;
  }
  
  void dispose() {
    _stopAmplitudeMonitor();
    _amplitudeController.close();
    _recorder.dispose();
  }
}
