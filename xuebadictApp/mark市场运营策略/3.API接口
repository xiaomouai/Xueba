### 4.2 核心表结构

```sql
-- 用户表
CREATE TABLE users (
    id VARCHAR(32) PRIMARY KEY,
    phone VARCHAR(20) UNIQUE NOT NULL,
    password_hash VARCHAR(128),
    nickname VARCHAR(50),
    avatar VARCHAR(255),
    gender ENUM('male', 'female', 'unknown') DEFAULT 'unknown',
    birthday DATE,
    role ENUM('student', 'parent') NOT NULL,
    grade TINYINT,
    level INT DEFAULT 1,
    exp INT DEFAULT 0,
    points INT DEFAULT 0,
    streak_days INT DEFAULT 0,
    invite_code VARCHAR(10) UNIQUE,
    invited_by VARCHAR(32),
    status ENUM('active', 'disabled') DEFAULT 'active',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX idx_phone (phone),
    INDEX idx_invite_code (invite_code)
);

-- 会员表
CREATE TABLE memberships (
    id VARCHAR(32) PRIMARY KEY,
    user_id VARCHAR(32) NOT NULL,
    plan_id VARCHAR(32) NOT NULL,
    level ENUM('free', 'basic', 'ai', 'vip') NOT NULL,
    start_at TIMESTAMP NOT NULL,
    expire_at TIMESTAMP NOT NULL,
    status ENUM('active', 'expired', 'cancelled') DEFAULT 'active',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_user_id (user_id),
    INDEX idx_expire_at (expire_at)
);

-- 教材表
CREATE TABLE textbooks (
    id VARCHAR(32) PRIMARY KEY,
    name VARCHAR(50) NOT NULL,
    publisher VARCHAR(50),
    icon VARCHAR(255),
    grades JSON,  -- [1,2,3,4,5,6]
    status ENUM('active', 'disabled') DEFAULT 'active',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 单元表
CREATE TABLE units (
    id VARCHAR(32) PRIMARY KEY,
    textbook_id VARCHAR(32) NOT NULL,
    grade TINYINT NOT NULL,
    term TINYINT NOT NULL,  -- 1上册 2下册
    unit_number TINYINT NOT NULL,
    name VARCHAR(100) NOT NULL,
    word_count INT DEFAULT 0,
    sort_order INT,
    status ENUM('active', 'disabled') DEFAULT 'active',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_textbook_grade (textbook_id, grade, term)
);

-- 单词表
CREATE TABLE words (
    id VARCHAR(32) PRIMARY KEY,
    word VARCHAR(100) NOT NULL,
    phonetic VARCHAR(100),
    meaning TEXT NOT NULL,
    audio_url VARCHAR(255),
    example TEXT,
    example_audio_url VARCHAR(255),
    image_url VARCHAR(255),
    difficulty TINYINT DEFAULT 1,
    knowledge_points JSON,  -- ["名词", "水果类"]
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_word (word)
);

-- 单元-单词关联表
CREATE TABLE unit_words (
    id VARCHAR(32) PRIMARY KEY,
    unit_id VARCHAR(32) NOT NULL,
    word_id VARCHAR(32) NOT NULL,
    sort_order INT,
    UNIQUE KEY uk_unit_word (unit_id, word_id),
    INDEX idx_unit_id (unit_id)
);

-- 用户单词学习记录
CREATE TABLE user_words (
    id VARCHAR(32) PRIMARY KEY,
    user_id VARCHAR(32) NOT NULL,
    word_id VARCHAR(32) NOT NULL,
    mastery_level TINYINT DEFAULT 0,  -- 0-5
    learn_count INT DEFAULT 0,
    correct_count INT DEFAULT 0,
    wrong_count INT DEFAULT 0,
    last_learn_at TIMESTAMP,
    next_review_at TIMESTAMP,  -- 艾宾浩斯复习时间
    is_favorite BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    UNIQUE KEY uk_user_word (user_id, word_id),
    INDEX idx_user_mastery (user_id, mastery_level),
    INDEX idx_next_review (user_id, next_review_at)
);

-- 错题记录表
CREATE TABLE wrong_records (
    id VARCHAR(32) PRIMARY KEY,
    user_id VARCHAR(32) NOT NULL,
    word_id VARCHAR(32) NOT NULL,
    question_type VARCHAR(20) NOT NULL,
    user_answer TEXT,
    correct_answer TEXT,
    error_type VARCHAR(20),  -- spelling/meaning/pronunciation
    is_mastered BOOLEAN DEFAULT FALSE,
    mastered_at TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_user_word (user_id, word_id),
    INDEX idx_user_type (user_id, error_type)
);

-- 发音评测记录表
CREATE TABLE pronunciation_records (
    id VARCHAR(32) PRIMARY KEY,
    user_id VARCHAR(32) NOT NULL,
    word_id VARCHAR(32),
    text VARCHAR(500) NOT NULL,
    audio_url VARCHAR(255) NOT NULL,
    overall_score INT,
    accuracy_score INT,
    fluency_score INT,
    pronunciation_score INT,
    phoneme_details JSON,
    evaluation_result JSON,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_user_created (user_id, created_at)
);

-- 学习记录表
CREATE TABLE study_logs (
    id VARCHAR(32) PRIMARY KEY,
    user_id VARCHAR(32) NOT NULL,
    date DATE NOT NULL,
    module VARCHAR(20) NOT NULL,  -- words/pronunciation/dictation/test
    duration INT DEFAULT 0,  -- 秒
    words_count INT DEFAULT 0,
    correct_count INT DEFAULT 0,
    points_earned INT DEFAULT 0,
    exp_earned INT DEFAULT 0,
    details JSON,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_user_date (user_id, date),
    INDEX idx_date_module (date, module)
);

-- 打卡记录表
CREATE TABLE checkin_records (
    id VARCHAR(32) PRIMARY KEY,
    user_id VARCHAR(32) NOT NULL,
    date DATE NOT NULL,
    streak_days INT DEFAULT 1,
    points_earned INT DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    UNIQUE KEY uk_user_date (user_id, date),
    INDEX idx_user_id (user_id)
);

-- 成就勋章表
CREATE TABLE achievements (
    id VARCHAR(32) PRIMARY KEY,
    name VARCHAR(50) NOT NULL,
    description VARCHAR(200),
    icon VARCHAR(255),
    category VARCHAR(20),
    condition_type VARCHAR(50),
    condition_value INT,
    points_reward INT DEFAULT 0,
    sort_order INT,
    status ENUM('active', 'disabled') DEFAULT 'active'
);

-- 用户成就记录
CREATE TABLE user_achievements (
    id VARCHAR(32) PRIMARY KEY,
    user_id VARCHAR(32) NOT NULL,
    achievement_id VARCHAR(32) NOT NULL,
    earned_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    UNIQUE KEY uk_user_achievement (user_id, achievement_id),
    INDEX idx_user_id (user_id)
);

-- 订单表
CREATE TABLE orders (
    id VARCHAR(32) PRIMARY KEY,
    user_id VARCHAR(32) NOT NULL,
    plan_id VARCHAR(32) NOT NULL,
    original_price DECIMAL(10, 2) NOT NULL,
    discount DECIMAL(10, 2) DEFAULT 0,
    final_price DECIMAL(10, 2) NOT NULL,
    promo_code VARCHAR(20),
    payment_method VARCHAR(20),
    payment_no VARCHAR(64),
    status ENUM('pending', 'paid', 'expired', 'refunded') DEFAULT 'pending',
    paid_at TIMESTAMP,
    expire_at TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_user_id (user_id),
    INDEX idx_status (status),
    INDEX idx_payment_no (payment_no)
);

-- 家长-孩子关联表
CREATE TABLE parent_child (
    id VARCHAR(32) PRIMARY KEY,
    parent_id VARCHAR(32) NOT NULL,
    child_id VARCHAR(32) NOT NULL,
    relationship VARCHAR(20),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    UNIQUE KEY uk_parent_child (parent_id, child_id),
    INDEX idx_parent_id (parent_id),
    INDEX idx_child_id (child_id)
);
```

