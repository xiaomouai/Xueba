// internal/service/member.go

package service

type MemberService struct {
    repo  *repository.MemberRepository
    cache *redis.Client
}

// ActivateMembership 开通会员
func (s *MemberService) ActivateMembership(ctx context.Context, msg *MemberActivateMessage) error {
    // 1. 获取套餐信息
    plan, err := s.repo.GetPlan(ctx, msg.PlanID)
    if err != nil {
        return fmt.Errorf("get plan failed: %w", err)
    }
    
    // 2. 获取当前会员信息
    currentMember, _ := s.repo.GetMembership(ctx, msg.UserID)
    
    // 3. 计算新的到期时间
    var startAt, expireAt time.Time
    if currentMember != nil && currentMember.ExpireAt.After(time.Now()) {
        // 如果还有剩余会员时间，则累加
        startAt = currentMember.ExpireAt
        expireAt = startAt.AddDate(0, 0, plan.DurationDays)
    } else {
        startAt = msg.PaidAt
        expireAt = startAt.AddDate(0, 0, plan.DurationDays)
    }
    
    // 4. 创建/更新会员记录
    membership := &model.Membership{
        ID:       generateID(),
        UserID:   msg.UserID,
        PlanID:   msg.PlanID,
        Level:    plan.Level,
        StartAt:  startAt,
        ExpireAt: expireAt,
        Status:   "active",
    }
    
    if err := s.repo.UpsertMembership(ctx, membership); err != nil {
        return fmt.Errorf("upsert membership failed: %w", err)
    }
    
    // 5. 更新订单状态为已完成
    if err := s.repo.UpdateOrderStatus(ctx, msg.OrderID, model.OrderStatusCompleted); err != nil {
        log.Error("update order status failed", "order_id", msg.OrderID, "error", err)
    }
    
    // 6. 清除用户缓存
    s.cache.Del(ctx, fmt.Sprintf("user:membership:%s", msg.UserID))
    
    // 7. 发送通知
    s.sendActivationNotify(ctx, msg.UserID, plan.Name, expireAt)
    
    return nil
}
