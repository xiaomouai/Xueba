    client    *http.Client
}

type UnifiedOrderRequest struct {
    AppID          string `xml:"appid"`
    MchID          string `xml:"mch_id"`
    NonceStr       string `xml:"nonce_str"`
    Sign           string `xml:"sign"`
    Body           string `xml:"body"`
    OutTradeNo     string `xml:"out_trade_no"`
    TotalFee       int    `xml:"total_fee"` // 单位：分
    SpbillCreateIP string `xml:"spbill_create_ip"`
    NotifyURL      string `xml:"notify_url"`
    TradeType      string `xml:"trade_type"` // APP
}

type UnifiedOrderResponse struct {
    ReturnCode string `xml:"return_code"`
    ReturnMsg  string `xml:"return_msg"`
    ResultCode string `xml:"result_code"`
    PrepayID   string `xml:"prepay_id"`
}

type AppPayParams struct {
    AppID     string `json:"appid"`
    PartnerID string `json:"partnerid"`
    PrepayID  string `json:"prepayid"`
    Package   string `json:"package"`
    NonceStr  string `json:"noncestr"`
    Timestamp string `json:"timestamp"`
    Sign      string `json:"sign"`
}

// CreateOrder 统一下单
func (w *WechatPay) CreateOrder(ctx context.Context, order *Order) (*AppPayParams, error) {
    // 1. 构建请求参数
    req := &UnifiedOrderRequest{
        AppID:          w.AppID,
        MchID:          w.MchID,
        NonceStr:       generateNonceStr(),
        Body:           order.ProductName,
        OutTradeNo:     order.OrderID,
        TotalFee:       int(order.Amount * 100), // 元转分
        SpbillCreateIP: order.ClientIP,
        NotifyURL:      w.NotifyURL,
        TradeType:      "APP",
    }
    
    // 2. 签名
    req.Sign = w.sign(req)
    
    // 3. 发送请求
    xmlData, _ := xml.Marshal(req)
    resp, err := w.client.Post(
        "https://api.mch.weixin.qq.com/pay/unifiedorder",
        "application/xml",
        strings.NewReader(string(xmlData)),
    )
    if err != nil {
        return nil, fmt.Errorf("request failed: %w", err)
    }
    defer resp.Body.Close()
    
    // 4. 解析响应
    var result UnifiedOrderResponse
    if err := xml.NewDecoder(resp.Body).Decode(&result); err != nil {
        return nil, fmt.Errorf("decode response failed: %w", err)
    }
    
    if result.ReturnCode != "SUCCESS" || result.ResultCode != "SUCCESS" {
        return nil, fmt.Errorf("wechat error: %s", result.ReturnMsg)
    }
    
    // 5. 构建APP支付参数
    timestamp := fmt.Sprintf("%d", time.Now().Unix())
    nonceStr := generateNonceStr()
    
    params := &AppPayParams{
        AppID:     w.AppID,
        PartnerID: w.MchID,
        PrepayID:  result.PrepayID,
        Package:   "Sign=WXPay",
        NonceStr:  nonceStr,
        Timestamp: timestamp,
    }
    
    // 6. 二次签名
    params.Sign = w.signAppParams(params)
    
    return params, nil
}

// HandleCallback 处理支付回调
func (w *WechatPay) HandleCallback(ctx context.Context, body []byte) (*CallbackResult, error) {
    // 1. 解析XML
    var notify WechatNotify
    if err := xml.Unmarshal(body, &notify); err != nil {
        return nil, fmt.Errorf("parse notify failed: %w", err)
    }
    
    // 2. 验证签名
    if !w.verifySign(&notify) {
        return nil, fmt.Errorf("invalid signature")
    }
    
    // 3. 验证业务结果
    if notify.ReturnCode != "SUCCESS" || notify.ResultCode != "SUCCESS" {
        return &CallbackResult{
            Success: false,
            OrderID: notify.OutTradeNo,
            Message: notify.ReturnMsg,
        }, nil
    }
    
    return &CallbackResult{
        Success:       true,
        OrderID:       notify.OutTradeNo,
        TransactionID: notify.TransactionID,
        Amount:        float64(notify.TotalFee) / 100, // 分转元
        PaidAt:        parseWechatTime(notify.TimeEnd),
    }, nil
}

// sign 生成签名
func (w *WechatPay) sign(data interface{}) string {
    // 将结构体转为map
    params := structToMap(data)
    
    // 按key排序
    keys := make([]string, 0, len(params))
    for k := range params {
        if k != "sign" && params[k] != "" {
            keys = append(keys, k)
        }
    }
    sort.Strings(keys)
    
    // 拼接字符串
    var buf strings.Builder
    for _, k := range keys {
        buf.WriteString(k)
        buf.WriteString("=")
        buf.WriteString(params[k])
        buf.WriteString("&")
    }
    buf.WriteString("key=")
    buf.WriteString(w.APIKey)
    
    // MD5签名
    hash := md5.Sum([]byte(buf.String()))
    return strings.ToUpper(hex.EncodeToString(hash[:]))
}
