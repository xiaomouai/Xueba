### 5.2 订单服务实现

```go
// internal/service/order.go

package service

import (
    "context"
    "time"
)

type OrderService struct {
    repo        *repository.OrderRepository
    paymentSvc  *PaymentService
    memberSvc   *MemberService
    cache       *redis.Client
    mq          *rabbitmq.Channel
}

// CreateOrder 创建订单
func (s *OrderService) CreateOrder(ctx context.Context, req *CreateOrderRequest) (*CreateOrderResponse, error) {
    // 1. 获取套餐信息
    plan, err := s.repo.GetPlan(ctx, req.PlanID)
    if err != nil {
        return nil, fmt.Errorf("get plan failed: %w", err)
    }
    
    // 2. 计算价格（含优惠）
    priceResult, err := s.calculatePrice(ctx, plan, req.PromoCode, req.UserID)
    if err != nil {
        return nil, fmt.Errorf("calculate price failed: %w", err)
    }
    
    // 3. 生成订单号
    orderID := s.generateOrderID()
    
    // 4. 创建订单记录
    order := &model.Order{
        ID:            orderID,
        UserID:        req.UserID,
        PlanID:        req.PlanID,
        PlanName:      plan.Name,
        OriginalPrice: priceResult.OriginalPrice,
        Discount:      priceResult.Discount,
        FinalPrice:    priceResult.FinalPrice,
        PromoCode:     req.PromoCode,
        PaymentMethod: req.PaymentMethod,
        Status:        model.OrderStatusPending,
        ExpireAt:      time.Now().Add(30 * time.Minute), // 30分钟有效期
        CreatedAt:     time.Now(),
    }
    
    if err := s.repo.CreateOrder(ctx, order); err != nil {
        return nil, fmt.Errorf("create order failed: %w", err)
    }
    
    // 5. 调用支付渠道获取支付参数
    payParams, err := s.paymentSvc.CreatePayment(ctx, &PaymentRequest{
        OrderID:       orderID,
        Amount:        priceResult.FinalPrice,
        ProductName:   plan.Name,
        PaymentMethod: req.PaymentMethod,
        ClientIP:      req.ClientIP,
    })
    if err != nil {
        // 更新订单状态为失败
        s.repo.UpdateOrderStatus(ctx, orderID, model.OrderStatusFailed)
        return nil, fmt.Errorf("create payment failed: %w", err)
    }
    
    // 6. 设置订单过期定时任务
    s.scheduleOrderExpire(orderID, 30*time.Minute)
    
    return &CreateOrderResponse{
        OrderID:       orderID,
        PlanName:      plan.Name,
        OriginalPrice: priceResult.OriginalPrice,
        Discount:      priceResult.Discount,
        FinalPrice:    priceResult.FinalPrice,
        PaymentMethod: req.PaymentMethod,
        PaymentParams: payParams,
        ExpireAt:      order.ExpireAt,
    }, nil
}

// HandlePaymentCallback 处理支付回调
func (s *OrderService) HandlePaymentCallback(ctx context.Context, result *CallbackResult) error {
    // 1. 幂等性检查
    processed, err := s.checkIdempotent(ctx, result.OrderID, result.TransactionID)
    if err != nil {
        return err
    }
    if processed {
        log.Info("callback already processed", "order_id", result.OrderID)
        return nil
    }
    
    // 2. 获取订单
    order, err := s.repo.GetOrder(ctx, result.OrderID)
    if err != nil {
        return fmt.Errorf("get order failed: %w", err)
    }
    
    // 3. 验证金额
    if result.Amount != order.FinalPrice {
        log.Error("amount mismatch", 
            "order_id", result.OrderID,
            "expected", order.FinalPrice,
            "actual", result.Amount,
        )
        return fmt.Errorf("amount mismatch")
    }
    
    // 4. 更新订单状态
    if !result.Success {
        return s.repo.UpdateOrderStatus(ctx, result.OrderID, model.OrderStatusFailed)
    }
    
    err = s.repo.UpdateOrderPaid(ctx, result.OrderID, &model.OrderPaidInfo{
        Status:        model.OrderStatusPaid,
        TransactionID: result.TransactionID,
        PaidAt:        result.PaidAt,
    })
    if err != nil {
        return fmt.Errorf("update order failed: %w", err)
    }
    
    // 5. 开通会员（异步）
    s.mq.Publish("member.activate", &MemberActivateMessage{
        UserID:    order.UserID,
        OrderID:   order.ID,
        PlanID:    order.PlanID,
        PaidAt:    result.PaidAt,
    })
    
    // 6. 标记幂等
    s.markIdempotent(ctx, result.OrderID, result.TransactionID)
    
    return nil
}

// checkIdempotent 幂等性检查
func (s *OrderService) checkIdempotent(ctx context.Context, orderID, transactionID string) (bool, error) {
    key := fmt.Sprintf("payment:callback:%s:%s", orderID, transactionID)
    result, err := s.cache.SetNX(ctx, key, "1", 24*time.Hour).Result()
    if err != nil {
        return false, err
    }
    return !result, nil // SetNX返回false表示key已存在，即已处理过
}

// generateOrderID 生成订单号
func (s *OrderService) generateOrderID() string {
    // 格式：ord_年月日_随机6位
    return fmt.Sprintf("ord_%s_%s", 
        time.Now().Format("20060102"),
        randomString(6),
    )
}

// scheduleOrderExpire 设置订单过期
func (s *OrderService) scheduleOrderExpire(orderID string, duration time.Duration) {
    // 延迟队列处理订单过期
    s.mq.PublishDelay("order.expire", &OrderExpireMessage{
        OrderID: orderID,
    }, duration)
}
