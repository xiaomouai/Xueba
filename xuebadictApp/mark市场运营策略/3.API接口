```go
// internal/service/pronunciation.go

package service

import (
    "context"
    "time"
)

type PronunciationService struct {
    engineFactory *engine.Factory
    audioProc     *audio.Processor
    repo          *repository.Repository
    ossClient     *oss.Client
}

// Evaluate 核心评测逻辑
func (s *PronunciationService) Evaluate(ctx context.Context, req *EvaluateRequest) (*EvaluateResponse, error) {
    
    // 1. 音频预处理
    processedAudio, err := s.preprocessAudio(req.Audio)
    if err != nil {
        return nil, fmt.Errorf("audio preprocess failed: %w", err)
    }
    
    // 2. 上传原始音频到OSS
    audioURL, err := s.uploadAudio(ctx, req.UserID, processedAudio)
    if err != nil {
        return nil, fmt.Errorf("upload audio failed: %w", err)
    }
    
    // 3. 获取AI引擎并调用评测
    engine := s.engineFactory.GetEngine("xunfei") // 可配置
    rawResult, err := engine.Evaluate(ctx, &engine.EvaluateInput{
        Audio:    processedAudio,
        Text:     req.Text,
        Type:     req.Type,
        UserType: "pupil", // 儿童模式
    })
    if err != nil {
        return nil, fmt.Errorf("ai evaluate failed: %w", err)
    }
    
    // 4. 结果后处理
    result := s.processResult(rawResult, req.Text)
    
    // 5. 生成音素建议
    result.Suggestions = s.generateSuggestions(result.Phonemes)
    
    // 6. 获取标准音频对比
    result.Comparison = s.getAudioComparison(req.WordID, audioURL)
    
    // 7. 计算积分奖励
    result.PointsEarned = s.calculatePoints(result.OverallScore)
    
    // 8. 保存评测记录
    evaluationID, err := s.saveRecord(ctx, req, result)
    if err != nil {
        // 记录保存失败不影响返回结果，只记录日志
        log.Errorf("save evaluation record failed: %v", err)
    }
    result.EvaluationID = evaluationID
    
    // 9. 异步更新用户统计数据
    go s.updateUserStats(req.UserID, result)
    
    return result, nil
}

// preprocessAudio 音频预处理
func (s *PronunciationService) preprocessAudio(audio []byte) ([]byte, error) {
    // 1. 格式检测
    format := s.audioProc.DetectFormat(audio)
    
    // 2. 转换为目标格式 (PCM 16kHz 16bit mono)
    if format != audio.FormatPCM16K {
        audio, err = s.audioProc.Convert(audio, audio.FormatPCM16K)
        if err != nil {
            return nil, err
        }
    }
    
    // 3. 音频增强（降噪、音量归一化）
    audio = s.audioProc.Enhance(audio, &audio.EnhanceOptions{
        NoiseReduce:     true,
        VolumeNormalize: true,
        TrimSilence:     true,
    })
    
    // 4. 音频校验（时长、质量）
    if err := s.audioProc.Validate(audio, &audio.ValidateOptions{
        MinDuration: 0.3,  // 最短0.3秒
        MaxDuration: 30.0, // 最长30秒
        MinVolume:   -40,  // 最小音量dB
    }); err != nil {
        return nil, err
    }
    
    return audio, nil
}

// generateSuggestions 生成改进建议
func (s *PronunciationService) generateSuggestions(phonemes []PhonemeResult) []string {
    var suggestions []string
    
    // 音素建议映射表
    phonemeTips := map[string]string{
        "θ":  "发 /θ/ 音时，舌尖轻触上齿，让气流从舌头和牙齿之间通过",
        "ð":  "发 /ð/ 音时，与 /θ/ 类似，但要振动声带",
        "æ":  "发 /æ/ 音时，嘴巴张大，舌头放低平，嘴角向两边咧开",
        "ʌ":  "发 /ʌ/ 音时，嘴巴微张，舌头放松置于口腔中部",
        "ə":  "发 /ə/ 音时，嘴巴自然张开，舌头放松",
        "ɪ":  "发 /ɪ/ 音时，嘴角微微咧开，舌头前部稍微抬起",
        "ʊ":  "发 /ʊ/ 音时，嘴唇稍微收圆，舌后部抬起",
        "r":  "发 /r/ 音时，舌尖向上卷起但不要接触上颚",
        "l":  "发 /l/ 音时，舌尖抵住上齿龈",
        "w":  "发 /w/ 音时，双唇收圆向前突出",
    }
    
    for _, p := range phonemes {
        if !p.IsCorrect && p.Score < 70 {
            if tip, ok := phonemeTips[p.Phoneme]; ok {
                suggestions = append(suggestions, tip)
            }
        }
    }
    
    // 去重并限制数量
    suggestions = uniqueStrings(suggestions)
    if len(suggestions) > 3 {
        suggestions = suggestions[:3]
    }
    
    // 添加鼓励语
    if len(suggestions) == 0 {
        suggestions = append(suggestions, "发音很标准，继续保持！")
    }
    
    return suggestions
}
