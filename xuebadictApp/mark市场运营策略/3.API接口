```go
// internal/engine/xunfei.go

package engine

import (
    "context"
    "encoding/base64"
    "encoding/json"
    "github.com/gorilla/websocket"
)

type XunfeiEngine struct {
    appID     string
    apiKey    string
    apiSecret string
    wsURL     string
}

func NewXunfeiEngine(config *XunfeiConfig) *XunfeiEngine {
    return &XunfeiEngine{
        appID:     config.AppID,
        apiKey:    config.APIKey,
        apiSecret: config.APISecret,
        wsURL:     "wss://ise-api.xfyun.cn/v2/open-ise",
    }
}

func (e *XunfeiEngine) Evaluate(ctx context.Context, input *EvaluateInput) (*EvaluateOutput, error) {
    // 1. 构建认证URL
    authURL := e.buildAuthURL()
    
    // 2. 建立WebSocket连接
    conn, _, err := websocket.DefaultDialer.DialContext(ctx, authURL, nil)
    if err != nil {
        return nil, fmt.Errorf("websocket dial failed: %w", err)
    }
    defer conn.Close()
    
    // 3. 发送第一帧（参数帧）
    firstFrame := e.buildFirstFrame(input)
    if err := conn.WriteJSON(firstFrame); err != nil {
        return nil, fmt.Errorf("send first frame failed: %w", err)
    }
    
    // 4. 分帧发送音频数据
    audioBase64 := base64.StdEncoding.EncodeToString(input.Audio)
    frameSize := 1280 // 每帧大小
    totalFrames := (len(audioBase64) + frameSize - 1) / frameSize
    
    for i := 0; i < totalFrames; i++ {
        start := i * frameSize
        end := start + frameSize
        if end > len(audioBase64) {
            end = len(audioBase64)
        }
        
        status := 1 // 中间帧
        if i == totalFrames-1 {
            status = 2 // 最后一帧
        }
        
        frame := e.buildAudioFrame(audioBase64[start:end], status)
        if err := conn.WriteJSON(frame); err != nil {
            return nil, fmt.Errorf("send audio frame failed: %w", err)
        }
        
        time.Sleep(40 * time.Millisecond) // 控制发送速率
    }
    
    // 5. 接收评测结果
    var result XunfeiResponse
    for {
        _, message, err := conn.ReadMessage()
        if err != nil {
            return nil, fmt.Errorf("read message failed: %w", err)
        }
        
        if err := json.Unmarshal(message, &result); err != nil {
            return nil, fmt.Errorf("parse response failed: %w", err)
        }
        
        if result.Code != 0 {
            return nil, fmt.Errorf("xunfei error: %s", result.Message)
        }
        
        if result.Data.Status == 2 { // 评测完成
            break
        }
    }
    
    // 6. 解析XML结果
    output := e.parseResult(result.Data.Data)
    
    return output, nil
}

// buildFirstFrame 构建首帧
func (e *XunfeiEngine) buildFirstFrame(input *EvaluateInput) map[string]interface{} {
    category := "read_word"
    if input.Type == "sentence" {
        category = "read_sentence"
    }
    
    return map[string]interface{}{
        "common": map[string]interface{}{
            "app_id": e.appID,
        },
        "business": map[string]interface{}{
            "category":   category,
            "rstcd":      "utf8",
            "group":      input.UserType,
            "check_type": "easy",
            "ise_unite":  "1",
            "plev":       "0",
        },
        "data": map[string]interface{}{
            "status":   0,
            "encoding": "raw",
            "format":   "audio/L16;rate=16000",
            "text":     "\ufeff" + input.Text, // BOM + 文本
        },
    }
}

// parseResult 解析讯飞返回的XML结果
func (e *XunfeiEngine) parseResult(xmlData string) *EvaluateOutput {
    // 解析XML并转换为标准输出格式
    // ... 解析逻辑
    
    return &EvaluateOutput{
        TotalScore:     85.5,
        AccuracyScore:  82.0,
        FluencyScore:   88.0,
        IntegrityScore: 90.0,
        PhonemeScores: []PhonemeScore{
            {Phoneme: "æ", Score: 75},
            {Phoneme: "p", Score: 95},
            {Phoneme: "l", Score: 88},
        },
